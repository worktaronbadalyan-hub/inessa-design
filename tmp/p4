function slideCanvas(car,i){let cv=document.createElement("canvas");cv.width=1080;cv.height=1350;cv.className="slide";drawSlide(cv,car,i);let wrap=document.createElement("div");wrap.className="sw";wrap.appendChild(cv);let b=document.createElement("button");b.textContent="PNG "+String(i+1).padStart(2,"0");b.onclick=()=>dl(cv,D.date+"_"+car.id+"_"+String(i+1).padStart(2,"0")+".png");wrap.appendChild(b);return wrap;}
let BUILT=false;
function build(){
 if(BUILT)return;BUILT=true;
 document.getElementById("date").textContent=D.date;
 const root=document.getElementById("cars");
 for(const car of D.carousels){
  let sec=document.createElement("section");
  sec.innerHTML=`<h2>Карусель ${car.id} · ${car.account} <span>${car.handle}</span></h2>
   <p class="meta">${car.framework} · хук ${car.hook} · ${car.lang} · ${car.slides.length} слайдов</p>`;
  let row=document.createElement("div");row.className="row";
  for(let i=0;i<car.slides.length;i++)row.appendChild(slideCanvas(car,i));
  sec.appendChild(row);
  let dall=document.createElement("button");dall.className="dall";dall.textContent="Скачать все PNG ("+car.id+")";
  dall.onclick=()=>{row.querySelectorAll("canvas").forEach((cv,i)=>setTimeout(()=>dl(cv,D.date+"_"+car.id+"_"+String(i+1).padStart(2,"0")+".png"),i*250));};
  sec.appendChild(dall);
  let det=document.createElement("details");det.innerHTML=`<summary>Подпись + alt-текст</summary><pre class="cap">${car.caption.replace(/</g,"&lt;")}</pre><p class="alt"><b>ALT:</b> ${car.alt}</p>`+(car.first_comment?`<p class="alt"><b>1-й комментарий:</b> ${car.first_comment}</p>`:"");
  sec.appendChild(det);
  root.appendChild(sec);
 }
 if(D.kp){
  let sec=document.createElement("section");
  sec.innerHTML=`<h2>Доп. задача дня · Слайд КП <span>1920×1080</span></h2><p class="meta">3 формата ИИ-тренинга (START / GROWTH / TRANSFORMATION), без цен · армянский</p>`;
  let cv=document.createElement("canvas");cv.width=1920;cv.height=1080;cv.className="kp";drawKP(cv,D.kp);
  sec.appendChild(cv);
  let b=document.createElement("button");b.className="dall";b.textContent="Скачать PNG (КП)";b.onclick=()=>dl(cv,D.date+"_KP_formats.png");
  sec.appendChild(document.createElement("br"));sec.appendChild(b);
  root.appendChild(sec);
 }
}
if(document.fonts&&document.fonts.ready){document.fonts.load("800 80px 'Noto Sans Armenian'").then(()=>document.fonts.load("600 40px 'Noto Sans Armenian'")).then(()=>document.fonts.load("40px Anton")).then(()=>document.fonts.ready).then(build);setTimeout(build,1500);}else build();
</script>
